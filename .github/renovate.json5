{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", ":semanticCommits", ":automergeDigest"],
  // Let GitHub merge the moment required checks pass, instead of waiting
  // for the next (delayed) hourly Renovate run. Requires "Allow auto-merge"
  // in repo settings and a required check on main (see all-pr-checks job).
  platformAutomerge: true,
  customManagers: [
    {
      customType: "regex",
      description: "Update _VERSION variables in Dockerfiles",
      managerFilePatterns: [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))? packageName=(?<packageName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s(?:ENV|ARG) .+?_VERSION=(?<currentValue>.+?)\\s",
      ],
    },
  ],
  packageRules: [
    {
      matchUpdateTypes: ["minor", "patch"],
      matchManagers: ["github-actions"],
      matchCurrentVersion: "!/^0/",
      automerge: true,
    },
    {
      addLabels: ["renovate/container", "type/major"],
      additionalBranchPrefix: "{{parentDir}}-",
      commitMessageExtra: " ( {{currentVersion}} → {{newVersion}} )",
      commitMessagePrefix: "feat({{parentDir}})!: ",
      commitMessageTopic: "{{depName}}",
      labels: ["apps/{{parentDir}}"],
      matchDatasources: ["docker", "github-releases"],
      matchFileNames: ["apps/**/Dockerfile"],
      matchUpdateTypes: ["major"],
    },
    {
      addLabels: ["renovate/container", "type/minor"],
      additionalBranchPrefix: "{{parentDir}}-",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
      commitMessageTopic: "{{depName}}",
      labels: ["apps/{{parentDir}}"],
      matchDatasources: ["docker", "github-releases"],
      matchFileNames: ["apps/**/Dockerfile"],
      matchUpdateTypes: ["minor"],
      semanticCommitScope: "{{parentDir}}",
      semanticCommitType: "feat",
      automerge: true,
    },
    {
      addLabels: ["renovate/container", "type/patch"],
      additionalBranchPrefix: "{{parentDir}}-",
      commitMessageExtra: "( {{currentVersion}} → {{newVersion}} )",
      commitMessageTopic: "{{depName}}",
      labels: ["apps/{{parentDir}}"],
      matchDatasources: ["docker", "github-releases"],
      matchFileNames: ["apps/**/Dockerfile"],
      matchUpdateTypes: ["patch"],
      semanticCommitScope: "{{parentDir}}",
      semanticCommitType: "fix",
      automerge: true,
    },
    {
      addLabels: ["renovate/container", "type/digest"],
      additionalBranchPrefix: "{{parentDir}}-",
      // Digest updates have no new version; newVersion renders empty
      // ("( 13 → )"). Show the short digest instead.
      commitMessageExtra: "( {{currentVersion}} → {{newDigestShort}} )",
      commitMessageTopic: "{{depName}}",
      labels: ["apps/{{parentDir}}"],
      matchDatasources: ["docker"],
      matchFileNames: ["apps/**/Dockerfile"],
      matchUpdateTypes: ["digest", "pinDigest"],
      semanticCommitScope: "{{parentDir}}",
      semanticCommitType: "chore",
      automerge: true,
      recreateWhen: "always",
    },
    {
      description:
        "Group per-tier child digest updates into one PR (same dep + digest across apps)",
      // Clear the per-app branch prefix so every app pinning the same tier
      // combines into a single branch/PR instead of one PR per app.
      additionalBranchPrefix: "",
      matchDatasources: ["docker"],
      matchDepNames: [
        "ghcr.io/kusold/alpine-base",
        "ghcr.io/kusold/alpine-base-runtime",
        "ghcr.io/kusold/debian-base",
        "ghcr.io/kusold/debian-base-runtime",
      ],
      matchFileNames: ["apps/**/Dockerfile"],
      matchUpdateTypes: ["digest", "pinDigest"],
      semanticCommitScope: "base-images",
    },
    {
      description: "Group caddy builder and runtime image updates into one PR",
      groupName: "caddy",
      matchDatasources: ["docker"],
      matchDepNames: ["caddy"],
      matchFileNames: ["apps/caddy/Dockerfile"],
    },
    {
      description: "Disable digest pinning for regex managers in Dockerfile",
      matchManagers: ["custom.regex"],
      matchDatasources: ["docker"],
      pinDigests: false,
    },
    {
      description: "Ignore self-referencing reusable workflows (kusold/containers)",
      matchManagers: ["github-actions"],
      matchDepNames: ["kusold/containers"],
      enabled: false,
    },
  ],
}
